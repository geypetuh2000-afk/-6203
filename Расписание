                ]}
            ]
        };

        let currentDay = 'Понедельник';
        let currentFilter = 'all';

        function setDay(day) {
            currentDay = day;
            document.querySelectorAll('.day-tab').forEach(btn => {
                btn.classList.remove('bg-indigo-600', 'text-white', 'shadow-sm');
                btn.classList.add('bg-slate-100', 'text-slate-600');
            });
            const activeBtn = document.getElementById(`btn-${day}`);
            activeBtn.classList.remove('bg-slate-100', 'text-slate-600');
            activeBtn.classList.add('bg-indigo-600', 'text-white', 'shadow-sm');
            renderSchedule();
        }

        function filterType(type) {
            currentFilter = type;
            renderSchedule();
        }

        function renderSchedule() {
            const container = document.getElementById('schedule-container');
            const daySlots = scheduleData[currentDay] || [];
            container.innerHTML = '';

            let hasVisibleSlots = false;

            daySlots.forEach(slot => {
                const filteredItems = slot.items.filter(item => {
                    if (currentFilter === 'all') return true;
                    return item.type === currentFilter;
                });

                if (filteredItems.length === 0) return;
                hasVisibleSlots = true;

                const slotEl = document.createElement('div');
                slotEl.className = 'bg-white rounded-xl p-4 android-shadow border border-slate-100';

                let itemsHtml = '';
                filteredItems.forEach(item => {
                    let badgeColor = 'bg-blue-100 text-blue-800';
                    let typeText = 'Лекция';
                    if (item.type === 'пр') {
                        badgeColor = 'bg-emerald-100 text-emerald-800';
                        typeText = 'Практика';
                    } else if (item.type === 'с') {
                        badgeColor = 'bg-amber-100 text-amber-800';
                        typeText = 'Семинар';
                    } else if (item.type === 'зачет') {
                        badgeColor = 'bg-rose-100 text-rose-800';
                        typeText = 'Зачет / К.Р.';
                    }

                    itemsHtml += `
                        <div class="py-3 border-b border-slate-100 last:border-none">
                            <div class="flex justify-between items-start mb-1">
                                <span class="text-xs font-semibold px-2 py-0.5 rounded-full ${badgeColor}">${typeText}</span>
                                <span class="text-xs text-slate-400 font-medium">${item.date}</span>
                            </div>
                            <h3 class="font-bold text-slate-800 text-base mb-1">${item.title}</h3>
                            <div class="flex justify-between text-xs text-slate-500">
                                <span><i class="fas fa-chalkboard-user mr-1 text-slate-400"></i>${item.teacher}</span>
                                <span class="font-medium text-indigo-600"><i class="fas fa-location-dot mr-1"></i>${item.room}</span>
                            </div>
                        </div>
                    `;
                });

                slotEl.innerHTML = `
                    <div class="flex items-center text-indigo-700 font-bold text-sm mb-2 pb-2 border-b border-indigo-50">
                        <i class="far fa-clock mr-2"></i> ${slot.time}
                    </div>
                    <div class="divide-y divide-slate-100">
                        ${itemsHtml}
                    </div>
                `;
                container.appendChild(slotEl);
            });

            if (!hasVisibleSlots) {
                container.innerHTML = `
                    <div class="text-center py-12 text-slate-400">
                        <i class="fas fa-mug-hot text-4xl mb-3"></i>
                        <p class="text-base font-medium">В этот день занятий по данному фильтру нет</p>
                    </div>
                `;
            }
        }

        // Initial render
        renderSchedule();
    </script>
