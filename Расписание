                    { date: "Декабрь", title: "Конст. право т. 14-15 ч. 2 с", teacher: "Луговский С.Г.", room: "ауд. 415", type: "с" },
                    { date: "Декабрь", title: "ИГПЗС т. 15.4 с", teacher: "Атливанчик А.П.", room: "ауд. 415", type: "с" },
                    { date: "Декабрь", title: "ИГПЗС т. 17.2 с", teacher: "Атливанчик А.П.", room: "ауд. 415", type: "с" }
                ]},
                { time: "11:30 - 12:50", items: [
                    { date: "Сент. (нед. 2)", title: "Ин. язык т. 2.1 пр", teacher: "Барбарчук В.А., Русак В.В.", room: "ауд. 415 / 412", type: "пр" },
                    { date: "Октябрь", title: "Совр. политэкономия т. 1.3 с", teacher: "Стельмах В.И.", room: "ауд. 415", type: "с" },
                    { date: "Октябрь", title: "ИГПЗС т. 9.5 с", teacher: "Атливанчик А.П.", room: "ауд. 415", type: "с" },
                    { date: "Ноябрь", title: "Первая помощь т. 5 пр", teacher: "Семенов В.В.", room: "ауд. 415", type: "пр" },
                    { date: "Ноябрь", title: "ППФП т. 17.2 пр", teacher: "Макась М.М., Богачев Е.С.", room: "с/з", type: "пр" },
                    { date: "Декабрь", title: "Первая помощь т. 8 пр", teacher: "Семенов В.В.", room: "ауд. 415", type: "пр" },
                    { date: "Декабрь", title: "Философия т. 9.2 с", teacher: "Лойко Л.Е.", room: "ауд. 415", type: "с" },
